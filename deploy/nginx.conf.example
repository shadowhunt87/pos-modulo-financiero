# Ejemplo detras de nginx (TLS lo pones tu con certbot/Cloudflare).
# El backend ya limita intentos de login en memoria, pero eso se reinicia con el proceso
# y no cubre varias replicas: este limite en el proxy es la primera barrera.
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m   rate=20r/s;

server {
    listen 443 ssl http2;
    server_name api.tudominio.com;
    # ssl_certificate ...; ssl_certificate_key ...;

    client_max_body_size 11m;               # MAX_UPLOAD_MB + margen

    location = /auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params;    # X-Forwarded-For, Host, etc. (TRUST_PROXY=1)
    }
    location / {
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/proxy_params;
    }
}
