# Base de datos (docker-compose.yml crea financial_user / financial_db)
DATABASE_URL="postgresql://financial_user:CAMBIAR@localhost:5432/financial_db"

# 32+ caracteres. Genera uno con: openssl rand -hex 64
JWT_SECRET=""

# Duración del token en SEGUNDOS (28800 = 8 horas)
JWT_EXPIRES_IN_SECONDS=28800

PORT=3000

# Solo para prisma/seed.ts
SEED_ADMIN_EMAIL="admin@sirtech.do"
SEED_ADMIN_PASSWORD=""
SEED_COMPANY_NAME="Sirtech"
SEED_COMPANY_TAX_ID=""
