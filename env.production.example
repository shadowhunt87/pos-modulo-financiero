# Copia a .env.production (NO lo subas a git) y llena TODO.
POSTGRES_USER=financial_user
POSTGRES_PASSWORD=          # openssl rand -hex 24
POSTGRES_DB=financial_db

JWT_SECRET=                 # openssl rand -hex 64
JWT_EXPIRES_IN_SECONDS=28800

PORT=3000
TRUST_PROXY=1               # cuantos proxies hay delante (nginx solo = 1; en pruebas NPM + nginx = 2)
CORS_ORIGINS=               # https://app.tudominio.com (vacio = CORS apagado)
MAX_UPLOAD_MB=10

# Verificacion en dos pasos (2FA)
TWO_FACTOR_ENCRYPTION_KEY=  # openssl rand -hex 32 (distinta de JWT_SECRET; guardala con la frase de los respaldos)
TWO_FACTOR_REQUIRED_ROLES=  # vacio al principio; ADMIN despues de la activacion acompañada (D41)
TWO_FACTOR_ISSUER=Finanzas  # nombre en la app del telefono (sin ":")
OPS_LOG_FILE=               # ruta de financiero-ops.log dentro del contenedor (opcional)

# Facturacion electronica (proveedor certificado)
ECF_ENCRYPTION_KEY=         # openssl rand -hex 32 (cifra las credenciales del proveedor; guardala con la frase de los respaldos)
ECF_WORKER_ENABLED=true     # envia los e-CF pendientes cada 30 s
